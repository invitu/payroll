<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="hr_payslip_view_form" model="ir.ui.view">
        <field name="name">hr.payslip.view.form.payroll.expense</field>
        <field name="model">hr.payslip</field>
        <field name="inherit_id" ref="payroll.hr_payslip_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    name="action_open_expense_sheets"
                    class="oe_stat_button"
                    icon="fa-money"
                    type="object"
                    invisible="expense_sheet_count == 0"
                >
                    <field
                        name="expense_sheet_count"
                        widget="statinfo"
                        string="Expense Reports"
                    />
                </button>
            </xpath>
        </field>
    </record>
</odoo>
